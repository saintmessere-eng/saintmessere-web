---
// Saint Messere — index.astro — raíz/vid de scroll + secuenciador de 7 pistas
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Saint Messere</title>
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --ink: #e8e4dc;
      --ink-dim: rgba(232,228,220,0.3);
      --ink-ghost: rgba(232,228,220,0.05);
      --bg: #0a0a0a;
      --bg-alt: #0d0d0d;
      --mono: 'Courier New', monospace;
      --serif: 'Georgia', serif;
      --gold: rgba(200,185,122,0.15);
      --gold-solid: #c8b97a;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--serif);
      overflow-x: hidden;
      cursor: none;
    }

    /* ── Cursor ── */
    .cursor {
      width: 6px; height: 6px;
      background: var(--ink);
      border-radius: 50%;
      position: fixed;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      mix-blend-mode: difference;
    }
    .cursor-ring {
      width: 36px; height: 36px;
      border: 1px solid rgba(232,228,220,0.3);
      border-radius: 50%;
      position: fixed;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%, -50%);
      transition: width 0.3s, height 0.3s, border-color 0.3s, opacity 0.3s;
    }
    body:has(a:hover) .cursor-ring,
    body:has(button:hover) .cursor-ring,
    body:has(.step:hover) .cursor-ring,
    body:has(.knob:hover) .cursor-ring {
      width: 56px; height: 56px;
      border-color: rgba(232,228,220,0.5);
    }

    /* ── Noise ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      opacity: 0.025;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    /* ── Canvas de partículas ── */
    #particles {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    /* ── Vignette ── */
    .vignette {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background: radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,0.6) 100%);
    }

    /* ── World — ya no recibe tilt de mouse, solo contiene la narrativa ── */
    #world {
      position: relative;
      z-index: 1;
    }

    /* ── Raíz / vid — conecta las secciones, fluye con el scroll ── */
    .root-vine {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }
    #rootVinePath {
      fill: none;
      stroke: rgba(200,185,122,0.16);
      stroke-width: 1.4;
    }
    .vine-node {
      fill: none;
      stroke: rgba(200,185,122,0.35);
      stroke-width: 1.4;
    }
    #rootVineDot {
      fill: var(--gold-solid);
      filter: drop-shadow(0 0 6px rgba(200,185,122,0.85)) drop-shadow(0 0 14px rgba(200,185,122,0.4));
    }

    /* ── Sections ── */
    section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 60px;
      position: relative;
      overflow: hidden;
      transform-style: preserve-3d;
      z-index: 1;
    }

    /* ── Capas de profundidad (entrada por scroll, no por mouse) ── */
    .depth-far {
      position: absolute;
      pointer-events: none;
      user-select: none;
      will-change: transform;
      transform: translateZ(-120px) scale(1.15);
    }
    .depth-mid {
      position: absolute;
      pointer-events: none;
      user-select: none;
      will-change: transform;
      transform: translateZ(-60px) scale(1.07);
    }
    .depth-near {
      position: relative;
      will-change: transform;
      transform: translateZ(0px);
    }

    /* ── Ghost chars ── */
    .ghost {
      font-family: var(--serif);
      font-style: italic;
      color: var(--ink-ghost);
      line-height: 1;
    }

    /* ── Líneas de horizonte ── */
    .horizon {
      position: absolute;
      left: 0; right: 0;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(232,228,220,0.04), transparent);
      pointer-events: none;
    }

    /* ── Reveal ── */
    [data-reveal] {
      opacity: 0;
      transition: opacity 1s ease, transform 1s ease;
    }
    [data-reveal="up"]    { transform: translateY(50px); }
    [data-reveal="left"]  { transform: translateX(-70px); }
    [data-reveal="scale"] { transform: scale(0.9); }
    [data-reveal="fade"]  { transform: none; }
    [data-reveal="depth"] { transform: translateZ(-40px) scale(0.96); opacity: 0; }
    [data-reveal].visible { opacity: 1; transform: none; }

    /* ── GLOW — texto de acento dorado, pulsación lenta ── */
    .glow {
      color: var(--gold-solid);
      text-shadow: 0 0 6px rgba(200,185,122,0.45), 0 0 16px rgba(200,185,122,0.2);
      animation: goldBreathe 4.6s ease-in-out infinite;
    }
    @keyframes goldBreathe {
      0%, 100% { text-shadow: 0 0 6px rgba(200,185,122,0.4), 0 0 14px rgba(200,185,122,0.16); }
      50%      { text-shadow: 0 0 10px rgba(200,185,122,0.65), 0 0 24px rgba(200,185,122,0.3); }
    }

    /* ═══════════════════════════════════════════
       RECEPTION — secuenciador (fuera de #world)
       ═══════════════════════════════════════════ */
    .reception {
      flex-direction: column;
      gap: 32px;
      background: radial-gradient(circle at 50% 35%, #100e0a 0%, var(--bg) 70%);
      z-index: 3;
    }
    .reception-eyebrow {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.4em;
      text-transform: uppercase;
    }

    .panel {
      position: relative;
      width: 100%;
      max-width: 900px;
      background: linear-gradient(165deg, #3c372e 0%, #221f1a 38%, #0d0c0a 100%);
      border-radius: 18px;
      padding: 24px 28px 28px;
      border: 1px solid #050504;
      box-shadow:
        0 30px 70px rgba(0,0,0,0.65),
        inset 0 2px 0 rgba(255,255,255,0.06),
        inset 0 -2px 0 rgba(0,0,0,0.5);
    }
    .panel-sheen {
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 42%;
      border-radius: 18px 18px 60% 60% / 18px 18px 30% 30%;
      background: linear-gradient(180deg, rgba(255,255,255,0.09), transparent);
      pointer-events: none;
    }
    .brushed {
      position: absolute;
      inset: 0;
      border-radius: 18px;
      pointer-events: none;
      background-image:
        repeating-linear-gradient(95deg, rgba(255,255,255,0.045) 0px, rgba(255,255,255,0.045) 1px, transparent 1px, transparent 4px),
        repeating-linear-gradient(95deg, rgba(0,0,0,0.07) 0px, rgba(0,0,0,0.07) 2px, transparent 2px, transparent 6px);
    }
    .screw {
      position: absolute;
      width: 10px; height: 10px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 28%, #7a7a7a, #161616 72%);
      box-shadow: inset 0 0 3px rgba(0,0,0,0.85), 0 1px 1px rgba(255,255,255,0.1);
      z-index: 3;
    }
    .screw::after {
      content: '';
      position: absolute;
      top: 50%; left: 13%;
      width: 74%; height: 1.2px;
      background: rgba(0,0,0,0.7);
      transform: translateY(-50%) rotate(36deg);
    }
    .screw.tl { top: 13px; left: 13px; }
    .screw.tr { top: 13px; right: 13px; }
    .screw.bl { bottom: 13px; left: 13px; }
    .screw.br { bottom: 13px; right: 13px; }

    .panel-header {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 18px;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .brand-mark {
      width: 38px; height: 38px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 28%, #4a4338, #15120e 75%);
      border: 1px solid rgba(200,185,122,0.5);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--mono);
      font-size: 12px;
      color: #e8d9a8;
      text-shadow: 0 0 6px rgba(232,217,168,0.6);
      box-shadow: inset 0 0 10px rgba(200,185,122,0.25), 0 2px 4px rgba(0,0,0,0.5);
      flex-shrink: 0;
    }
    .brand-text { flex: 1; min-width: 0; }
    .brand-title { font-family: var(--serif); font-size: 16px; color: #f0ece2; line-height: 1.2; }
    .brand-sub {
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(232,228,220,0.35);
      margin-top: 3px;
    }
    .lcd {
      background: linear-gradient(160deg, #1c2616, #0a0f08);
      border: 1px solid #000;
      border-radius: 5px;
      padding: 8px 14px;
      box-shadow: inset 0 3px 8px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(255,255,255,0.04);
      position: relative;
      overflow: hidden;
      min-width: 150px;
      flex-shrink: 0;
      text-align: center;
    }
    .lcd::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(180deg, rgba(0,0,0,0.35) 0px, rgba(0,0,0,0.35) 1px, transparent 1px, transparent 3px);
      pointer-events: none;
    }
    .lcd-text {
      position: relative;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: #b9f08a;
      text-shadow: 0 0 8px rgba(185,240,138,0.85), 0 0 16px rgba(185,240,138,0.4);
      white-space: nowrap;
    }

    .seq-screen {
      position: relative;
      z-index: 2;
      background: linear-gradient(160deg, #0d0d0d, #020202);
      border-radius: 12px;
      padding: 16px 14px;
      box-shadow: inset 0 4px 14px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(255,255,255,0.05);
      max-height: 320px;
      overflow-y: auto;
    }
    .sequencer { display: flex; flex-direction: column; gap: 9px; }
    .track-row { display: flex; align-items: center; gap: 9px; }
    .track-label {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #d8d2c2;
      text-shadow: 0 1px 1px rgba(0,0,0,0.8);
      width: 38px;
      flex-shrink: 0;
    }
    .track-mute {
      width: 18px; height: 14px;
      border-radius: 3px;
      background: linear-gradient(150deg, #3a3a3a, #161616);
      border: 1px solid rgba(0,0,0,0.6);
      font-family: var(--mono);
      font-size: 7px;
      color: rgba(232,228,220,0.4);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      user-select: none;
    }
    .track-mute.muted {
      background: linear-gradient(150deg, #5a2420, #2a0f0d);
      color: #ffb3a6;
      border-color: rgba(255,90,60,0.5);
      box-shadow: 0 0 6px rgba(255,90,60,0.4);
    }
    .track-led {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #3a1810, #150805 70%);
      box-shadow: inset 0 0 2px rgba(0,0,0,0.8);
      flex-shrink: 0;
    }
    .track-led.lit {
      background: radial-gradient(circle at 35% 30%, #fff3d0, #ffb84d 70%);
      box-shadow: 0 0 9px 3px rgba(255,184,77,0.9), 0 0 18px 6px rgba(255,184,77,0.45);
    }
    .steps { display: grid; grid-template-columns: repeat(16, 1fr); gap: 4px; flex: 1; }
    .step {
      aspect-ratio: 1;
      border-radius: 4px;
      background: linear-gradient(150deg, #4a4a48 0%, #232220 45%, #0d0c0b 100%);
      border: 1px solid rgba(0,0,0,0.6);
      box-shadow:
        inset 1px 1px 2px rgba(255,255,255,0.15),
        inset -2px -2px 4px rgba(0,0,0,0.6);
      cursor: pointer;
    }
    .step.beat { box-shadow:
        inset 1px 1px 2px rgba(255,255,255,0.15),
        inset -2px -2px 4px rgba(0,0,0,0.6),
        inset 0 0 0 1px rgba(232,217,168,0.28); }
    .step.active {
      background: linear-gradient(150deg, #ffe8a8 0%, #f0b248 45%, #a86a1e 100%);
      border-color: rgba(255,225,150,0.7);
      box-shadow:
        0 0 14px 3px rgba(255,178,72,0.7),
        0 0 28px 8px rgba(255,178,72,0.3),
        inset 1px 1px 2px rgba(255,255,255,0.65),
        inset -2px -2px 3px rgba(120,70,15,0.55);
    }
    .step.playhead { outline: 2px solid #fff; outline-offset: 1px; }

    .controls-screen {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      flex-wrap: wrap;
      margin-top: 18px;
      background: linear-gradient(160deg, #16140f, #0a0908);
      border-radius: 12px;
      padding: 18px 22px;
      box-shadow: inset 0 3px 10px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.04);
    }
    .knobs-row { display: flex; gap: 28px; flex-wrap: wrap; }

    .knob {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding-top: 4px;
      cursor: grab;
      user-select: none;
      touch-action: none;
    }
    .knob:active { cursor: grabbing; }
    .knob-ring { position: absolute; top: -4px; left: 50%; width: 60px; height: 60px; transform: translateX(-50%); pointer-events: none; }
    .knob-ring-bg, .knob-ring-fg {
      fill: none; stroke-width: 3; stroke-linecap: round;
      transform: rotate(-225deg); transform-origin: 30px 30px;
    }
    .knob-ring-bg { stroke: rgba(255,255,255,0.08); stroke-dasharray: 122.65 40.88; }
    .knob-ring-fg { stroke: var(--gold-solid); filter: drop-shadow(0 0 4px rgba(200,185,122,0.6)); stroke-dasharray: 0 163.53; }
    .knob-body {
      width: 54px; height: 54px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 26%, #6a6358 0%, #2c2820 45%, #0d0b08 100%);
      border: 1px solid #050403;
      box-shadow:
        0 5px 10px rgba(0,0,0,0.65),
        inset 2px 2px 3px rgba(255,255,255,0.22),
        inset -3px -3px 5px rgba(0,0,0,0.7);
      position: relative;
      z-index: 1;
    }
    .knob-body::before {
      content: '';
      position: absolute;
      top: 18%; left: 22%;
      width: 28%; height: 16%;
      border-radius: 50%;
      background: rgba(255,255,255,0.4);
      filter: blur(2px);
    }
    .knob-indicator {
      position: absolute;
      bottom: 50%; left: 50%;
      width: 3px; height: 19px;
      margin-left: -1.5px;
      background: linear-gradient(to top, #c8b97a, #fff3d0);
      box-shadow: 0 0 7px rgba(232,217,168,0.8);
      border-radius: 2px;
      transform-origin: 50% 100%;
    }
    .knob-label { font-family: var(--mono); font-size: 8px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(232,228,220,0.5); }
    .knob-value { font-family: var(--mono); font-size: 10px; color: #e8d9a8; text-shadow: 0 0 5px rgba(232,217,168,0.4); min-width: 44px; text-align: center; }

    .power-unit { display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .power-btn {
      width: 54px; height: 54px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 26%, #4a4642 0%, #18160f 75%);
      border: 2px solid #020201;
      box-shadow:
        0 5px 10px rgba(0,0,0,0.65),
        inset 2px 2px 3px rgba(255,255,255,0.16),
        inset -3px -3px 5px rgba(0,0,0,0.75);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
    }
    .power-led {
      width: 9px; height: 9px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #4a1810, #1a0805 70%);
      box-shadow: inset 0 0 3px rgba(0,0,0,0.6);
    }
    .power-btn.on .power-led {
      background: radial-gradient(circle at 35% 30%, #ffb39e, #ff4422 70%);
      box-shadow: 0 0 11px 4px rgba(255,68,34,0.8), 0 0 24px 8px rgba(255,68,34,0.38);
    }
    .power-label { font-family: var(--mono); font-size: 8px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(232,228,220,0.45); }

    .hw-button {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #d8d2c2;
      background: linear-gradient(150deg, #3a382f, #161410);
      border: 1px solid #050403;
      border-radius: 6px;
      padding: 13px 20px;
      box-shadow:
        inset 1px 1px 2px rgba(255,255,255,0.14),
        inset -2px -2px 4px rgba(0,0,0,0.55),
        0 2px 4px rgba(0,0,0,0.4);
      cursor: pointer;
    }
    .hw-button:hover { color: var(--gold-solid); }

    .float-mute {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 50;
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: rgba(200,185,122,0.45);
      background: rgba(10,10,10,0.55);
      border: 1px solid rgba(200,185,122,0.2);
      padding: 10px 18px;
      border-radius: 20px;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s ease, color 0.3s, border-color 0.3s;
    }
    .float-mute.visible { opacity: 1; pointer-events: all; }
    .float-mute:hover { color: var(--gold-solid); border-color: rgba(200,185,122,0.5); }

    /* ── HERO ── */
    .hero { flex-direction: column; text-align: center; background: var(--bg); perspective: 800px; }
    .hero-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.35em; text-transform: uppercase; margin-bottom: 48px; }
    .hero-name { font-size: clamp(64px, 13vw, 148px); font-weight: 400; line-height: 0.88; letter-spacing: -0.02em; transform-style: preserve-3d; }
    .hero-name .light { color: rgba(232,228,220,0.12); font-style: italic; display: block; transform: translateZ(-20px); }
    .hero-name .bold { display: block; transform: translateZ(20px); }
    .hero-sub { margin-top: 48px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.25em; }

    .scroll-hint {
      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 10px;
      opacity: 0; animation: fadeIn 1s ease 1.4s forwards;
    }
    .scroll-hint span { font-family: var(--mono); font-size: 9px; letter-spacing: 0.35em; color: rgba(232,228,220,0.18); text-transform: uppercase; }
    .scroll-hint::after {
      content: ''; width: 1px; height: 56px;
      background: linear-gradient(to bottom, rgba(232,228,220,0.2), transparent);
      animation: scrollPulse 2.4s ease infinite;
    }
    @keyframes fadeIn { to { opacity: 1; } }
    @keyframes scrollPulse {
      0%   { transform: scaleY(0); transform-origin: top; }
      49%  { transform: scaleY(1); transform-origin: top; }
      50%  { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }

    /* ── MANIFESTO ── */
    .manifesto { background: var(--bg-alt); flex-direction: column; }
    .manifesto-wrap { max-width: 640px; width: 100%; }
    .m-line { font-size: clamp(26px, 4vw, 46px); font-weight: 400; line-height: 1.15; padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid var(--ink-ghost); }
    .m-line:last-child { border-bottom: none; }
    .m-em   { color: var(--ink); }
    .m-dim  { color: rgba(232,228,220,0.2); }
    .m-mid  { color: rgba(232,228,220,0.55); }
    .m-italic { font-style: italic; font-size: clamp(14px, 2vw, 20px); }

    /* ── PILLARS ── */
    .pillars { background: var(--bg); flex-direction: column; gap: 72px; }
    .pillars-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.45em; text-transform: uppercase; }
    .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(232,228,220,0.06); width: 100%; max-width: 900px; }
    .pillar { background: var(--bg); padding: 48px 32px; transition: background 0.4s ease, transform 0.4s ease; transform-style: preserve-3d; }
    .pillar:hover { background: #0f0f0f; transform: translateZ(12px); }
    .pillar-num { font-family: var(--mono); font-size: 10px; letter-spacing: 0.2em; margin-bottom: 24px; }
    .pillar h3 { font-size: 22px; font-weight: 400; margin-bottom: 18px; line-height: 1.2; }
    .pillar p { font-family: var(--mono); font-size: 11px; color: rgba(232,228,220,0.32); line-height: 1.9; letter-spacing: 0.04em; }

    /* ── TEATRO ── */
    .teatro { background: var(--bg-alt); flex-direction: column; text-align: center; gap: 64px; }
    .teatro h2 { font-size: clamp(38px, 7vw, 84px); font-weight: 400; letter-spacing: -0.02em; line-height: 1.05; }
    .teatro h2 em { font-style: italic; color: rgba(232,228,220,0.22); }
    .acts { display: flex; align-items: center; gap: 48px; }
    .act { display: flex; flex-direction: column; align-items: center; gap: 14px; }
    .act-symbol { font-size: 28px; opacity: 0.45; line-height: 1; transition: opacity 0.4s, transform 0.4s; }
    .act:hover .act-symbol { opacity: 0.9; transform: translateZ(20px) scale(1.1); }
    .act-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; }
    .act-sep { font-size: 16px; color: rgba(232,228,220,0.08); padding-bottom: 20px; }

    /* ── CIERRE ── */
    .cierre { background: var(--bg); flex-direction: column; text-align: center; gap: 36px; }
    .cierre-quote { font-size: clamp(17px, 2.8vw, 30px); font-style: italic; color: rgba(232,228,220,0.45); max-width: 560px; line-height: 1.6; }
    .cierre-quote strong { color: var(--ink); font-weight: 400; }
    .cierre-sig { font-family: var(--mono); font-size: 11px; letter-spacing: 0.3em; }
    .cierre-links { display: flex; gap: 48px; justify-content: center; margin-top: 16px; }
    .cierre-link {
      font-family: var(--mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase;
      color: rgba(200,185,122,0.45); text-decoration: none; padding-bottom: 4px;
      border-bottom: 1px solid rgba(200,185,122,0.15);
      transition: color 0.3s, border-color 0.3s, transform 0.3s, text-shadow 0.3s;
      display: inline-block;
    }
    .cierre-link:hover {
      color: var(--gold-solid); border-color: rgba(200,185,122,0.6);
      text-shadow: 0 0 10px rgba(200,185,122,0.6), 0 0 22px rgba(200,185,122,0.3);
      transform: translateY(-2px);
    }

    /* ── Responsive ── */
    @media (max-width: 760px) {
      section { padding: 60px 22px; }
      .panel { padding: 18px 14px 20px; }
      .panel-header { flex-wrap: wrap; }
      .lcd { min-width: 100%; order: 3; margin-top: 6px; }
      .seq-screen { max-height: 280px; padding: 12px 10px; }
      .sequencer { gap: 6px; }
      .track-row { gap: 6px; }
      .track-label { font-size: 8px; width: 26px; }
      .steps { gap: 2px; }
      .controls-screen { justify-content: center; gap: 18px; padding: 16px; }
      .knobs-row { gap: 18px; justify-content: center; }

      .pillars-grid { grid-template-columns: 1fr; }
      .acts { flex-direction: column; gap: 28px; }
      .act-sep { transform: rotate(90deg); }
      .cierre-links { gap: 24px; flex-wrap: wrap; justify-content: center; }

      .hero-eyebrow { font-size: 13px; }
      .hero-sub { font-size: 13px; }
      .m-dim { color: rgba(232,228,220,0.45); }
      .m-italic { font-size: 16px; }
      .pillar p { font-size: 13px; color: rgba(232,228,220,0.55); line-height: 2; }
      .pillars-label { font-size: 12px; }
      .act-label { font-size: 12px; }
      .cierre-sig { font-size: 12px; }
      .cierre-link { font-size: 12px; }
      .cierre-quote { font-size: clamp(18px, 4.5vw, 26px); color: rgba(232,228,220,0.65); }
    }
  </style>
</head>
<body>

  <canvas id="particles"></canvas>
  <div class="vignette"></div>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>
  <button class="float-mute" id="floatMute">Silenciar</button>

  <!-- ── RECEPTION — secuenciador, fuera de #world ── -->
  <section class="reception" id="reception">
