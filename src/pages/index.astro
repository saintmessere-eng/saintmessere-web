              <circle class="knob-ring-bg" cx="30" cy="30" r="26"></circle>
              <circle class="knob-ring-fg" cx="30" cy="30" r="26"></circle>
            </svg>
            <div class="knob-body"><div class="knob-indicator"></div></div>
